node_modules/
dist/
.env
.env.local
*.local
.DS_Store
tsconfig.tsbuildinfo
.env.audit
dist-audit/
.vercel/
# `vercel link` writes .env.local with a VERCEL_OIDC_TOKEN; ignore every
# env file and re-admit the checked-in template.
.env*
!.env.example

# `supabase link` writes local CLI state here: the project ref, the pooler
# connection URL, and pinned tool versions. Machine state for whoever ran the
# link, not source — same reason .vercel/ is ignored above.
supabase/.temp/

# The VAPID private key that authorises a push. Written by
# scripts/vapid-keys.mjs for you to paste into Supabase's secrets, and it must
# never reach the repo — anyone holding it can send notifications as this app.
.vapid-keys.local.txt

# graphify's knowledge graph — generated from the source it indexes, ~14MB
# with its cache. Regenerated by `graphify update .`, so it is derived output,
# not a checked-in artefact.
graphify-out/
