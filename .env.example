# Create the Supabase project first (§1.1), then fill these in.
# With these unset the app runs on the local mock adapter (approved accelerator).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google integration (Gmail read, Calendar, Drive).
# Only the CLIENT ID is needed — it is public by design, and no client secret
# exists anywhere in this codebase, so none can leak from it.
VITE_GOOGLE_CLIENT_ID=

# YouTube Data API v3 — resolves a song pick to the real video (artwork + a
# direct Play link). Optional: without it, Play falls back to a YouTube search.
# This key SHIPS IN THE BUNDLE — restrict it in Cloud Console to the two site
# referrers and to the YouTube Data API alone before using it.
VITE_YOUTUBE_API_KEY=

# Web Push (Part 6). The PUBLIC key is public by design — it identifies this
# app to the browser's push service and ships in the bundle. The matching
# PRIVATE key is a secret and lives only in Supabase's function secrets:
#   npx supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=mailto:you@example.com
# Generate a pair with scripts/vapid-keys.mjs.
VITE_VAPID_PUBLIC_KEY=
